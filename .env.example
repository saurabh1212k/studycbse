# StudyOS – Streamlit Web App Configuration
# ─────────────────────────────────────────────────────────────
# 1. For LOCAL development:
#    Copy this file to `.env`:
#      cp .env.example .env
#    And fill in your keys below.
#
# 2. For STREAMLIT CLOUD (Community Cloud):
#    Do NOT upload .env! Instead, paste these in:
#      Streamlit App Settings → Secrets
# ─────────────────────────────────────────────────────────────

# Supabase Credentials (Database & Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Gemini API Key (AI Doubt Solver & Notes)
GEMINI_API_KEY=your_gemini_api_key_here
