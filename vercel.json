{
  "version": 2,
  "builds": [
    {
      "src": "api/webhook.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/webhook.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30 2 * * *"
    }
  ]
}
